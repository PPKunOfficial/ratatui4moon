///|
/// 伪像素符号表（上游 `symbols/pixel.rs`）：象限（2x2）/六分（2x3）/
/// 八分（2x4）块字符，Canvas 的 PatternGrid 以行主序位图取用喵。
///
/// 注意：下标**不是** Unicode 码点序，而是各字符 2xW 伪像素网格的
/// 行主序位图，语义与 `braille_symbol.mbt` 一致喵。
pub let quadrants : Array[Char] = [
  ' ', '▘', '▝', '▀', '▖', '▌', '▞', '▛', '▗', '▚', '▐', '▜',
  '▄', '▙', '▟', '█',
]

