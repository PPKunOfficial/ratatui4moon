  mut current_line : Array[@core.StyledGrapheme]
  trim : Bool
}
pub fn WordWrapper::new(Array[(Array[@core.StyledGrapheme], @core.Alignment)], Int, Bool) -> Self
pub impl LineComposer for WordWrapper

pub(all) struct Wrap {
  trim : Bool
} derive(Eq, @debug.Debug)
pub fn Wrap::of(Bool) -> Self

pub(all) struct WrappedLine {
  graphemes : Array[@core.StyledGrapheme]
  width : Int
  alignment : @core.Alignment
}

